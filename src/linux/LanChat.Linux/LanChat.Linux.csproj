<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>lanchat</AssemblyName>
    <RootNamespace>LanChat.Linux</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>true</PublishTrimmed>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Models.cs" Link="Models.cs" />
    <Compile Include="..\..\NetworkService.cs" Link="NetworkService.cs" />
    <Compile Include="..\..\NetworkService.Interface.cs" Link="NetworkService.Interface.cs" />
    <Compile Include="..\..\NetworkService.Discovery.cs" Link="NetworkService.Discovery.cs" />
    <Compile Include="..\..\NetworkService.Transfer.cs" Link="NetworkService.Transfer.cs" />
  </ItemGroup>

</Project>

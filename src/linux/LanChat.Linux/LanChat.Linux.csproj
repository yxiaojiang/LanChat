<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeFrameworkVersion>10.0.15</RuntimeFrameworkVersion>
    <AssemblyName>lanchat</AssemblyName>
    <RootNamespace>LanChat.Linux</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>true</PublishTrimmed>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\..\assets\WeChatEmoji.pack" LogicalName="LanChat.WeChatEmoji.pack" />
    <Compile Include="..\..\Models.cs" Link="Models.cs" />
    <Compile Include="..\..\Services\EmojiPack.cs" Link="EmojiPack.cs" />
    <Compile Include="..\..\NetworkService.cs" Link="NetworkService.cs" />
    <Compile Include="..\..\NetworkService.Interface.cs" Link="NetworkService.Interface.cs" />
    <Compile Include="..\..\NetworkService.Discovery.cs" Link="NetworkService.Discovery.cs" />
    <Compile Include="..\..\NetworkService.Transfer.cs" Link="NetworkService.Transfer.cs" />
    <Compile Include="..\..\Services\AppSettings.cs" Link="AppSettings.cs" />
    <Compile Include="..\..\Services\SessionManager.cs" Link="SessionManager.cs" />
    <Compile Include="..\..\Services\ChatHistoryService.cs" Link="ChatHistoryService.cs" />
  </ItemGroup>

</Project>
